{
  "name": "@assign/cli-discuss",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts*",
    "build": "bun build ./src/index.tsx --compile --minify --outfile ./dist/assign-discuss",
    "build:all": "./build-all.sh"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.20",
    "@assistant-ui/react-ink": "0.0.44",
    "@assistant-ui/react-ink-markdown": "0.0.43",
    "ink": "7.0.0",
    "react": "19.2.0",
    "react-devtools-core": "8.0.0",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
